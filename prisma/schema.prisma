

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id             String         @id @default(cuid())
  name           String
  email          String         @unique
  password       String?
  location       String?
  headline       String?
  bio            String?
  skills         String[]       @default([])
  approvalStatus ApprovalStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  applications  Application[]
  cvAnalysis    CVAnalysis[]
  jobMatches    JobMatch[]
}

model Application {
  id            String    @id @default(cuid())
  userId        String
  company       String
  position      String
  status        String    @default("applied") // applied, interview, rejected, offer
  dateApplied   DateTime  @default(now())
  location      String?
  salary        String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

model CVAnalysis {
  id            String    @id @default(cuid())
  userId        String
  fileName      String
  cvText        String    @default("")
  atsScore      Int?
  strengths     String[]  @default([])
  weaknesses    String[]  @default([])
  missingSkills String[]  @default([])
  suggestions   String[]  @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobMatches    JobMatch[]

  @@index([userId])
}

model JobMatch {
  id                  String   @id @default(cuid())
  userId              String
  cvAnalysisId        String
  jobDescription      String
  matchPercentage     Int
  matchingSkills      String[] @default([])
  missingSkills       String[] @default([])
  recommendedKeywords String[] @default([])
  suggestions         String[] @default([])
  createdAt           DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cvAnalysis CVAnalysis @relation(fields: [cvAnalysisId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([cvAnalysisId])
}